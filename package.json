{
  "name": "stella",
  "version": "1.0.0",
  "description": "Stella — persistent AI sidebar companion for Chrome",
  "main": "background.js",
  "scripts": {
    "test": "jest --testPathPatterns=tests/ --verbose",
    "build": "./build.sh",
    "build:fast": "./build.sh --skip-tests --no-obfuscate",
    "build:skip-tests": "./build.sh --skip-tests",
    "build:release": "./build.sh",
    "release": "./release.sh"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "keywords": [
    "chrome-extension",
    "ai",
    "sidebar",
    "sidepanel"
  ],
  "author": "Hatim Cherkaoui",
  "license": "UNLICENSED",
  "devDependencies": {
    "clean-css-cli": "^5.6.3",
    "javascript-obfuscator": "^5.4.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "terser": "^5.46.1"
  }
}
